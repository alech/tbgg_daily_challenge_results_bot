# Local development only. The deployed Lambda reads these from SSM Parameter Store.
# Copy to .env (gitignored) and fill in.

# The _ncfa session cookie: geoguessr.com signed in -> DevTools -> Application -> Cookies.
# GeoGuessr signs in with emailed one-time codes, so there is no password to automate;
# this cookie is replaced by hand when it expires.
GEOGUESSR_NCFA=

# Discord bot token, the channel results are posted to, and who gets failure DMs.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALERT_USER_ID=
